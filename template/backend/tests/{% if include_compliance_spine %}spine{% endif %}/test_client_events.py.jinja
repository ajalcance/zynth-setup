"""A client may report what it saw. It may not report who saw it.

Everything in the request body was written by code on someone else's machine. These tests pin
the boundary: the fields that decide *attribution* — actor, session, IP, timestamp, and the
trust marker that keeps the event out of the audit chain — come from the request, and a body
that tries to supply them is ignored rather than merged.
"""

from __future__ import annotations

import json
from typing import Any

from fakeredis.aioredis import FakeRedis
from httpx import AsyncClient

from {{ python_package }}.api.routes_client_events import RATE_LIMIT
from {{ python_package }}.auth.principal import issue_token
from {{ python_package }}.config import get_settings

ENDPOINT = "/api/v1/client-events"


def _auth(sub: str = "user-123", sid: str = "sess-9") -> dict[str, str]:
    return {"Authorization": f"Bearer {issue_token(sub, sid)}"}


async def _events(redis: FakeRedis) -> list[dict[str, Any]]:
    """Everything currently on the telemetry stream, oldest first."""
    entries = await redis.xrange(get_settings().telemetry_stream) or []
    return [json.loads(fields["e"]) for _, fields in entries if fields]


# --- Authentication ---------------------------------------------------------------------------


async def test_anonymous_report_is_rejected(client: AsyncClient, fake_redis: FakeRedis) -> None:
    """Recorded as `system` would mean an event nobody can be asked about."""
    resp = await client.post(ENDPOINT, json={"action": "client.error"})
    assert resp.status_code == 401
    assert await _events(fake_redis) == [], "nothing may be stored for a rejected report"


async def test_forged_token_is_rejected(client: AsyncClient) -> None:
    resp = await client.post(
        ENDPOINT,
        json={"action": "client.error"},
        headers={"Authorization": "Bearer user-123.sess-9.deadbeef"},
    )
    assert resp.status_code == 401


# --- Attribution is the server's, not the client's ---------------------------------------------


async def test_report_is_attributed_to_the_authenticated_caller(
    client: AsyncClient, fake_redis: FakeRedis
) -> None:
    resp = await client.post(
        ENDPOINT,
        json={"action": "client.error", "metadata": {"message": "boom"}},
        headers=_auth(),
    )
    assert resp.status_code == 202
    (event,) = await _events(fake_redis)
    assert event["actor"] == {"type": "user", "id": "user-123", "sid": "sess-9"}
    assert event["source"] == "client"
    assert event["metadata"]["message"] == "boom"


async def test_a_body_cannot_attribute_the_report_to_someone_else(
    client: AsyncClient, fake_redis: FakeRedis
) -> None:
    """The whole point of the endpoint. A caller must not be able to impersonate."""
    resp = await client.post(
        ENDPOINT,
        json={
            "action": "client.error",
            "actor_type": "system",
            "actor_id": "root",
            "sid": "someone-elses-session",
            "ip": "10.0.0.1",
            "source": "server",
            "category": "auth",
        },
        headers=_auth(),
    )
    assert resp.status_code == 202
    (event,) = await _events(fake_redis)
    assert event["actor"]["id"] == "user-123", "actor came from the body, not the token"
    assert event["actor"]["sid"] == "sess-9", "session came from the body"
    assert event["source"] == "client", "a client talked its way out of the client source marker"
    assert event["category"] == "client", "category came from the body"
    assert event["ip"] != "10.0.0.1", "IP came from the body"


# --- What a client is allowed to say ------------------------------------------------------------


async def test_an_unlisted_action_is_rejected(client: AsyncClient, fake_redis: FakeRedis) -> None:
    """Free-form actions would mint event types no detection rule has ever seen."""
    resp = await client.post(ENDPOINT, json={"action": "admin.deleted_everything"}, headers=_auth())
    assert resp.status_code == 422
    assert await _events(fake_redis) == []


async def test_a_client_cannot_declare_its_report_critical(
    client: AsyncClient, fake_redis: FakeRedis
) -> None:
    """Severity drives alerting — otherwise a browser tab can page the on-call rota."""
    resp = await client.post(
        ENDPOINT, json={"action": "client.error", "severity": "critical"}, headers=_auth()
    )
    assert resp.status_code == 422
    assert await _events(fake_redis) == []


async def test_an_unknown_outcome_is_rejected(client: AsyncClient) -> None:
    resp = await client.post(
        ENDPOINT, json={"action": "client.error", "outcome": "maybe"}, headers=_auth()
    )
    assert resp.status_code == 422


async def test_metadata_key_count_is_bounded(client: AsyncClient, fake_redis: FakeRedis) -> None:
    resp = await client.post(
        ENDPOINT,
        json={"action": "client.error", "metadata": {f"k{i}": "v" for i in range(50)}},
        headers=_auth(),
    )
    assert resp.status_code == 422
    assert await _events(fake_redis) == []


async def test_metadata_values_are_truncated(client: AsyncClient, fake_redis: FakeRedis) -> None:
    """A durable store is the wrong place to discover someone posted a megabyte."""
    resp = await client.post(
        ENDPOINT,
        json={"action": "client.error", "metadata": {"stack": "x" * 10_000}},
        headers=_auth(),
    )
    assert resp.status_code == 202
    (event,) = await _events(fake_redis)
    assert len(event["metadata"]["stack"]) <= 512


async def test_nested_metadata_is_rejected(client: AsyncClient) -> None:
    resp = await client.post(
        ENDPOINT,
        json={"action": "client.error", "metadata": {"ctx": {"nested": "object"}}},
        headers=_auth(),
    )
    assert resp.status_code == 422


# --- Volume ------------------------------------------------------------------------------------


async def test_a_runaway_client_is_capped(client: AsyncClient, fake_redis: FakeRedis) -> None:
    """A retry loop in a released frontend is the realistic flood, not an attacker."""
    for _ in range(RATE_LIMIT):
        resp = await client.post(ENDPOINT, json={"action": "client.error"}, headers=_auth())
        assert resp.status_code == 202
    resp = await client.post(ENDPOINT, json={"action": "client.error"}, headers=_auth())
    assert resp.status_code == 429
    assert len(await _events(fake_redis)) == RATE_LIMIT


async def test_the_cap_is_per_session(client: AsyncClient) -> None:
    """One noisy session must not silence everyone else's reports."""
    for _ in range(RATE_LIMIT):
        await client.post(ENDPOINT, json={"action": "client.error"}, headers=_auth())
    other = await client.post(
        ENDPOINT, json={"action": "client.error"}, headers=_auth("user-999", "sess-other")
    )
    assert other.status_code == 202
