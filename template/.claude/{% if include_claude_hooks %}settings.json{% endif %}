{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",
      "Bash(git push --force*)",
      "Bash(git push --force-with-lease*)",
      "Bash(sudo *)",
      "Bash(curl * | *)",
      "Bash(wget * | *)",
      "Bash(npm publish *)",
      "Bash(gh secret *)",
      "Bash(git commit --no-verify*)",
      "Bash(git config core.hooksPath*)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)",
      "MultiEdit(./.claude/settings.json)",
      "NotebookEdit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Write(./.claude/settings.local.json)",
      "MultiEdit(./.claude/settings.local.json)",
      "NotebookEdit(./.claude/settings.local.json)"
    ],
    "ask": [
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "MultiEdit(./.claude/**)",
      "NotebookEdit(./.claude/**)",
      "Bash(git tag *)",
      "Bash(git push --tags*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(rm -rf *)",
      "Bash(gh release *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo *)",
      "Bash(gh ruleset *)",
      "Bash(gh api -X *)",
      "Bash(gh api --method *)",
      "Bash(gh workflow run *)",
      "Bash(docker *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(pip install *)",
      "Bash(npm install *)"
    ],
    "allow": [
      "Bash(make *)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ci)",
      "Bash(npx prettier *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(black *)",
      "Bash(mypy *)",
      "Bash(python3 scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git stash*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(gh run watch*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(sed -n *)",
      "Bash(awk *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(echo *)",
      "Bash(backend/.venv/bin/pytest *)",
      "Bash(backend/.venv/bin/ruff *)",
      "Bash(backend/.venv/bin/black *)",
      "Bash(backend/.venv/bin/mypy *)",
      "Bash(backend/.venv/bin/bandit *)",
      "Bash(backend/.venv/bin/pip-audit *)",
      "Bash(backend/.venv/bin/pre-commit *)",
      "Bash(backend/.venv/bin/semgrep *)",
      "Bash(backend/.venv/bin/zizmor *)",
      "Bash(npx eslint *)",
      "Bash(npx next *)",
      "Bash(npx playwright *)",
      "Bash(pre-commit run*)",
      "Bash(actionlint*)",
      "Bash(shellcheck *)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh api repos/*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_dangerous_bash.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/confine_to_project.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_secret_write.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/approved_scope.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_python.py\""
          }
        ]
      }
    ]
  }
}
