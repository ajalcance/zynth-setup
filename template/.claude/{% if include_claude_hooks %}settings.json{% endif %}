{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)"
    ],
    "ask": [
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "MultiEdit(./.claude/**)",
      "NotebookEdit(./.claude/**)",
      "Edit(./.github/**)",
      "Write(./.github/**)",
      "MultiEdit(./.github/**)",
      "NotebookEdit(./.github/**)",
      "Edit(./scripts/**)",
      "Write(./scripts/**)",
      "MultiEdit(./scripts/**)",
      "NotebookEdit(./scripts/**)",
      "Edit(./tests/guards/**)",
      "Write(./tests/guards/**)",
      "MultiEdit(./tests/guards/**)",
      "NotebookEdit(./tests/guards/**)",
      "Edit(./.semgrep/**)",
      "Write(./.semgrep/**)",
      "MultiEdit(./.semgrep/**)",
      "NotebookEdit(./.semgrep/**)",
      "Edit(./.gitleaks.toml)",
      "Write(./.gitleaks.toml)",
      "MultiEdit(./.gitleaks.toml)",
      "NotebookEdit(./.gitleaks.toml)",
      "Edit(./.pre-commit-config.yaml)",
      "Write(./.pre-commit-config.yaml)",
      "MultiEdit(./.pre-commit-config.yaml)",
      "NotebookEdit(./.pre-commit-config.yaml)",
      "Edit(./Makefile)",
      "Write(./Makefile)",
      "MultiEdit(./Makefile)",
      "NotebookEdit(./Makefile)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)",
      "MultiEdit(./CLAUDE.md)",
      "NotebookEdit(./CLAUDE.md)",
      "Edit(./AGENTS.md)",
      "Write(./AGENTS.md)",
      "MultiEdit(./AGENTS.md)",
      "NotebookEdit(./AGENTS.md)",
      "Edit(./deploy/**)",
      "Write(./deploy/**)",
      "MultiEdit(./deploy/**)",
      "NotebookEdit(./deploy/**)",
      "Edit(./docs/decisions/**)",
      "Write(./docs/decisions/**)",
      "MultiEdit(./docs/decisions/**)",
      "NotebookEdit(./docs/decisions/**)",
      "Bash(git tag *)",
      "Bash(git push --tags*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(rm -rf *)",
      "Bash(gh release *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo *)",
      "Bash(gh secret *)",
      "Bash(gh ruleset *)",
      "Bash(gh api -X *)",
      "Bash(gh api --method *)",
      "Bash(gh workflow run *)",
      "Bash(docker *)",
      "Bash(sudo *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(curl * | *)",
      "Bash(pip install *)",
      "Bash(npm install *)",
      "Bash(npm publish *)"
    ],
    "allow": [
      "Bash(make *)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ci)",
      "Bash(npx prettier *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(black *)",
      "Bash(mypy *)",
      "Bash(python3 scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git stash*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(gh run watch*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_dangerous_bash.py\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_secret_write.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_python.py\""
          }
        ]
      }
    ]
  }
}
