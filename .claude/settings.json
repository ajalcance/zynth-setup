{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_HOOKS_NEVER_ASK": "1"
  },
  "permissions": {
    "allow": ["Read", "Glob", "Grep", "Edit", "Write", "MultiEdit", "NotebookEdit", "Bash"],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.test)",
      "Read(.env.staging)",
      "Read(.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",

      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "MultiEdit(./.claude/**)",
      "NotebookEdit(./.claude/**)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)",
      "MultiEdit(./.claude/settings.json)",
      "NotebookEdit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Write(./.claude/settings.local.json)",
      "MultiEdit(./.claude/settings.local.json)",
      "NotebookEdit(./.claude/settings.local.json)",

      "Bash(git tag*)",
      "Bash(git push --tags*)",
      "Bash(git push *--tags*)",
      "Bash(git push *--follow-tags*)",
      "Bash(git push *refs/tags/*)",
      "Bash(gh release*)",
      "Bash(gh pr merge*)",
      "Bash(gh label*)",
      "Bash(gh repo*)",
      "Bash(gh secret*)",
      "Bash(gh variable*)",
      "Bash(gh ruleset*)",
      "Bash(gh workflow run*)",
      "Bash(gh workflow enable*)",
      "Bash(gh workflow disable*)",
      "Bash(npm publish*)",

      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push *-f *)",
      "Bash(git push * -f)",
      "Bash(git push *--delete*)",
      "Bash(git push *-d *)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",

      "Bash(ssh*)",
      "Bash(scp*)",
      "Bash(sudo*)",
      "Bash(docker*)",
      "Bash(curl * | *)",
      "Bash(wget * | *)",

      "Bash(*--admin*)",
      "Bash(*--no-verify*)",
      "Bash(*core.hooksPath*)",
      "Bash(*--add-label*)",
      "Bash(*--remove-label*)",
      "Bash(*--label *)",
      "Bash(*--label=*)",
      "Bash(gh api *-X *)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *--input*)",
      "Bash(gh api *labels*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_dangerous_bash.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/confine_to_project.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_secret_write.py\""
          }
        ]
      }
    ]
  }
}
