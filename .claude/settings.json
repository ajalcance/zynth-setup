{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",
      "Bash(git push --force*)",
      "Bash(git push --force-with-lease*)",
      "Bash(sudo *)",
      "Bash(curl * | *)",
      "Bash(wget * | *)",
      "Bash(npm publish *)",
      "Bash(gh secret *)",
      "Bash(git commit --no-verify*)",
      "Bash(git config core.hooksPath*)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)",
      "MultiEdit(./.claude/settings.json)",
      "NotebookEdit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Write(./.claude/settings.local.json)",
      "MultiEdit(./.claude/settings.local.json)",
      "NotebookEdit(./.claude/settings.local.json)"
    ],
    "ask": [
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "MultiEdit(./.claude/**)",
      "NotebookEdit(./.claude/**)",
      "Edit(./.github/**)",
      "Write(./.github/**)",
      "MultiEdit(./.github/**)",
      "NotebookEdit(./.github/**)",
      "Edit(./scripts/**)",
      "Write(./scripts/**)",
      "MultiEdit(./scripts/**)",
      "NotebookEdit(./scripts/**)",
      "Edit(./tests/**)",
      "Write(./tests/**)",
      "MultiEdit(./tests/**)",
      "NotebookEdit(./tests/**)",
      "Edit(./Makefile)",
      "Write(./Makefile)",
      "MultiEdit(./Makefile)",
      "NotebookEdit(./Makefile)",
      "Edit(./requirements-selftest.txt)",
      "Write(./requirements-selftest.txt)",
      "MultiEdit(./requirements-selftest.txt)",
      "NotebookEdit(./requirements-selftest.txt)",
      "Edit(./.pre-commit-config.yaml)",
      "Write(./.pre-commit-config.yaml)",
      "MultiEdit(./.pre-commit-config.yaml)",
      "NotebookEdit(./.pre-commit-config.yaml)",
      "Edit(./.gitleaks.toml)",
      "Write(./.gitleaks.toml)",
      "MultiEdit(./.gitleaks.toml)",
      "NotebookEdit(./.gitleaks.toml)",
      "Edit(./.gitleaksignore)",
      "Write(./.gitleaksignore)",
      "MultiEdit(./.gitleaksignore)",
      "NotebookEdit(./.gitleaksignore)",
      "Bash(git tag *)",
      "Bash(git push --tags*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(rm -rf *)",
      "Bash(gh release *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo *)",
      "Bash(gh ruleset *)",
      "Bash(gh workflow run *)",
      "Bash(docker *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(pip install *)"
    ],
    "allow": [
      "Bash(make *)",
      "Bash(python3 scripts/*)",
      "Bash(python3 template/scripts/*)",
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/bin/ruff *)",
      "Bash(.venv/bin/black *)",
      "Bash(.venv/bin/pre-commit *)",
      "Bash(.venv/bin/zizmor *)",
      "Bash(shellcheck *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git stash*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(gh run watch*)",
      "Bash(gh api repos/*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(sed -n *)",
      "Bash(awk *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(echo *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_dangerous_bash.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/confine_to_project.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_secret_write.py\""
          }
        ]
      }
    ]
  }
}
